{
	"name": "fitatu-mcp",
	"version": "2.0.0",
	"description": "Unofficial Model Context Protocol server for Fitatu",
	"private": true,
	"type": "module",
	"main": "dist/index.js",
	"scripts": {
		"build": "vite build",
		"dev": "node --env-file=.env --watch src/index.ts | pino-pretty",
		"inspector": "npx @modelcontextprotocol/inspector",
		"start": "node --env-file=.env dist/index.js",
		"test": "vitest",
		"test:integration": "node --env-file=.env ./node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts",
		"test:ci": "vitest run --config vitest.config.ts --coverage --reporter=json --outputFile=test-results.json",
		"test:coverage": "vitest run --config vitest.config.ts --coverage",
		"typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
		"lint": "eslint src tests vitest.config.ts vitest.integration.config.ts",
		"lint:fix": "eslint src tests vitest.config.ts vitest.integration.config.ts --fix",
		"format": "prettier --write src tests vitest.config.ts vitest.integration.config.ts",
		"format:check": "prettier --check src tests vitest.config.ts vitest.integration.config.ts"
	},
	"keywords": [
		"fitatu",
		"mcp",
		"model-context-protocol",
		"typescript",
		"nutrition",
		"unofficial"
	],
	"author": "Daniel Legawiec",
	"license": "MIT",
	"engines": {
		"node": ">=22.18.0"
	},
	"devDependencies": {
		"@types/node": "^26.1.1",
		"@typescript-eslint/eslint-plugin": "^8.65.0",
		"@typescript-eslint/parser": "^8.65.0",
		"@vitest/coverage-v8": "^4.1.10",
		"concurrently": "^10.0.4",
		"eslint": "^10.8.0",
		"globals": "^17.7.0",
		"prettier": "^3.9.6",
		"typescript": "~6.0.3",
		"vite": "^8.1.5",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.29.0",
		"@types/express": "^5.0.6",
		"express": "^5.2.1",
		"pino": "^10.3.1",
		"pino-pretty": "^13.1.3"
	}
}
