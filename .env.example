# Server
# Transport: "http" (default) or "stdio" for MCP clients that spawn the server.
MCP_TRANSPORT=http

# Only used by the http transport.
PORT=3000
# HTTP bind address. Not sensitive. The tunnel launcher overrides this to 127.0.0.1.
HOST=0.0.0.0
NODE_ENV=development
SERVER_NAME=fitatu-mcp
SERVER_VERSION=2.0.0
LOG_LEVEL=info

# Fitatu credentials
# Required. Sensitive in real environments.
FITATU_EMAIL=your-fitatu-email@example.com
FITATU_PASSWORD=your-fitatu-password

# Dedicated Fitatu test account credentials.
# Required by test:integration, dev:all, and dev:test-account. Sensitive in real environments.
FITATU_INTEGRATION_EMAIL=your-integration-fitatu-email@example.com
FITATU_INTEGRATION_PASSWORD=your-integration-fitatu-password

# Optional Fitatu mobile client profile.
FITATU_USER_AGENT='Dart/3.10 (dart:io)'
FITATU_APP_VERSION=4.14.4
FITATU_API_APK_UUID=BE4B.251210.005

# Optional development tunnel settings (not sensitive).
# Set these in .env for dev:all / dev:test-account.
# NGROK_DOMAIN is required by those commands: use your assigned free ngrok domain.
# Authenticate ngrok separately with `ngrok config add-authtoken`.
# NGROK_DOMAIN=your-assigned-domain.ngrok-free.dev
# TUNNEL_PORT=3100
# TUNNEL_PERSONAL_PORT=3000
# TUNNEL_TEST_PORT=3001
